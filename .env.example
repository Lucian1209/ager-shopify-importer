# --- Shopify (Dev Dashboard app, client-credentials grant) ---
SHOPIFY_SHOP=your-shop.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10
# Optional: numeric id or gid://shopify/Location/... (default: the first active location)
SHOPIFY_LOCATION_ID=

# --- Access to the dashboard / API (required; use a long random string) ---
APP_API_KEY=

# --- Feeds ---
# Optional: seeds the first feed of an EMPTY database (more feeds are added in the dashboard)
AGER_FEED_URL=
MARKUP_PERCENT=0
MARKUP_FIXED=0
# Where feeds and cached XML live. Use a persistent disk (e.g. /var/data/...) to survive redeploys.
FEED_DB_PATH=/tmp/feeds.db
FEED_CACHE_DIR=/tmp/importer-feeds

# --- Sync behaviour ---
# true = nothing is written to Shopify (default). Explicit POST /sync?dry_run=false still writes.
SYNC_DRY_RUN=true
# Scheduled run every N minutes (0 = scheduler off) and how many products per feed per run (0 = whole feed)
SYNC_INTERVAL_MINUTES=360
SYNC_LIMIT=10
# false = for products that already exist only price/stock/variants are updated (titles, descriptions, images stay as edited in Shopify)
SYNC_UPDATE_CONTENT=true
LOG_LEVEL=INFO
